{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": "\"Geist Serif\", \"Iowan Old Style\", Georgia, serif",
      "sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": {
      "$type": "fontWeight",
      "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800
    }
  },
  "text": {
    "$type": "typography",
    "display-lg": { "family": "display", "size": 64, "line": 64, "weight": "regular", "tracking": "-0.025em", "usage": "Heróis e momentos de marca." },
    "display-md": { "family": "display", "size": 48, "line": 52, "weight": "regular", "tracking": "-0.022em", "usage": "Título principal de páginas de destaque." },
    "display-sm": { "family": "display", "size": 40, "line": 44, "weight": "regular", "tracking": "-0.02em", "usage": "Título de página." },
    "heading-xl": { "family": "display", "size": 32, "line": 38, "weight": "regular", "tracking": "-0.018em", "usage": "Título de painéis e modais grandes." },
    "heading-lg": { "family": "display", "size": 26, "line": 32, "weight": "regular", "tracking": "-0.014em", "usage": "Título de seção." },
    "heading-md": { "family": "display", "size": 21, "line": 28, "weight": "regular", "tracking": "-0.01em", "usage": "Subtítulo de seção, título de card grande." },
    "heading-sm": { "family": "sans", "size": 17, "line": 24, "weight": "semibold", "tracking": "-0.016em", "usage": "Título de card e grupos." },
    "heading-xs": { "family": "sans", "size": 15, "line": 22, "weight": "semibold", "tracking": "-0.011em", "usage": "Título de item de lista." },
    "body-lg": { "family": "sans", "size": 18, "line": 32, "weight": "regular", "tracking": "-0.014em", "usage": "Texto de leitura em destaque." },
    "body-md": { "family": "sans", "size": 16, "line": 28, "weight": "regular", "tracking": "-0.011em", "usage": "Texto de leitura padrão (painéis, roteiros)." },
    "body-sm": { "family": "sans", "size": 14, "line": 22, "weight": "regular", "tracking": "-0.006em", "usage": "Texto de apoio e descrições." },
    "label-lg": { "family": "sans", "size": 16, "line": 22, "weight": "medium", "tracking": "-0.011em", "usage": "Navegação principal, botões grandes." },
    "label-md": { "family": "sans", "size": 14, "line": 20, "weight": "medium", "tracking": "-0.006em", "usage": "Botões, campos, itens de menu." },
    "label-sm": { "family": "sans", "size": 13, "line": 18, "weight": "medium", "tracking": "-0.003em", "usage": "Chips, badges, rótulos compactos." },
    "eyebrow": { "family": "sans", "size": 13, "line": 18, "weight": "medium", "tracking": "0", "usage": "Rótulo acima de títulos (ex.: “Roteiro”)." },
    "caption": { "family": "sans", "size": 12, "line": 16, "weight": "regular", "tracking": "0", "usage": "Metadados, legendas, timestamps." },
    "overline": { "family": "sans", "size": 11, "line": 16, "weight": "semibold", "tracking": "0.08em", "transform": "uppercase", "usage": "Categorias em caixa alta." },
    "code-md": { "family": "mono", "size": 14, "line": 22, "weight": "regular", "tracking": "0", "usage": "Blocos de código." },
    "code-sm": { "family": "mono", "size": 12, "line": 18, "weight": "regular", "tracking": "0", "usage": "Código inline e nomes de token." }
  }
}
